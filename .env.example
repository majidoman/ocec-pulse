# Pulse survey — installation settings. install.ps1 / install.sh fill the secrets for you.
# Keep this file private: it holds the database password and the setup code.

# The address people type in the browser. Sign-in works only on this exact address,
# and only over HTTPS or http://localhost.
PUBLIC_URL=http://localhost:8080
APP_PORT=8080

# Secrets — long random values, never reuse, never change AUTH_SECRET after setup
# (it also protects the saved mailbox password).
DB_PASSWORD=change-me
AUTH_SECRET=change-me
CRON_SECRET=change-me

# Entered once in the setup wizard to create the owner account. Delete the value after setup if you like.
SETUP_CODE=change-me

# "I'm not a robot" box on sign-in, account creation and password reset (self-hosted, no outside
# service). Leave "on"; set to "off" only on a closed network that has its own protection.
PULSE_CAPTCHA=on

# Time zone for scheduled jobs and dates.
TZ=Asia/Muscat
# Nightly backup (cron format, local time) and how many days of backups to keep in ./backups
BACKUP_CRON=30 1 * * *
BACKUP_KEEP_DAYS=14
# Daily reminder emails to people who have not answered yet.
REMINDER_CRON=0 9 * * *

# Optional HTTPS front door: docker compose --profile https up -d
# PUBLIC_HOST=survey.client.local
# TLS_MODE=internal          # self-signed for internal names; remove the line for a real certificate on a public domain
